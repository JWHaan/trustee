# Copy to .env (gitignored). Every value is optional. Empty means dry-run:
# no network calls, local order ids, and scripted LLM replies.

# --- PayPal sandbox (Developer Dashboard -> sandbox app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) | live. The sandbox_poc example refuses live.
PAYPAL_ENV=sandbox
# The order's payee: one of your sandbox BUSINESS accounts (Testing Tools -> Sandbox Accounts).
# The placeholder default only works in dry-run; real PayPal refuses to authorize it.
PAYPAL_SELLER_EMAIL=
# Verifies inbound webhooks (the webhook id from the sandbox app). Empty means
# live webhooks are rejected.
PAYPAL_WEBHOOK_ID=
# Payer-approval redirect targets. Default to TRUSTEE_PUBLIC_URL when that is
# set, otherwise they stay empty.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# --- OpenAI-compatible LLM (NIM, OpenAI, Ollama, ...)
# Temperature is fixed at 0.1 in src/trustee/llm.py and is not configurable here.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Empty key means scripted mode (recorded moves, no network).
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# JSON merged into every request. Nemotron 3.5 returns empty content unless thinking is off.
LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# Seconds per model request before the run falls back to the recorded moves.
LLM_TIMEOUT=30

# --- Platform API and arena server
# Public base URL. Used in the Agent Card and as the default host of the
# PayPal return/cancel URLs. Set it to the real deployed URL.
TRUSTEE_PUBLIC_URL=
# Gates POST /v1/principals and POST /v1/deals/{id}/resolve. Empty means
# principal registration is open and /resolve returns 403. Set it on any
# shared server.
TRUSTEE_OPERATOR_TOKEN=
# SQLite file for principals, agents, mandates, deals and events. Empty means
# in-memory, so a restart forgets them. Use a path on a persistent disk.
TRUSTEE_DB_PATH=
# JSONL ledger path. Empty means in-memory.
TRUSTEE_LEDGER_PATH=
# Deadline sweep interval in seconds.
TRUSTEE_SWEEP_SECONDS=30
# Dev only. Set to 1 to let a dry-run server accept unsigned webhooks.
TRUSTEE_WEBHOOK_ALLOW_UNVERIFIED=
# Override the directory that serves the built UI. Empty means the bundled
# arena/ui/dist, which the Docker image sets.
ARENA_UI_DIR=

# --- Human-not-present payments (see docs/AUTONOMY.md)
# Ed25519 private key (base64 of 32 raw bytes) that signs settlement receipts. Empty: Trustee generates one and
# keeps it in the store (TRUSTEE_DB_PATH), or per process when the store is in-memory. Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
TRUSTEE_SIGNING_KEY=
# A PayPal Vault payment-token id (a SECRET: never commit it) from your sandbox buyer's one-time consent.
# With it the arena's sandbox runs pay under the signed intent mandate with no approval click. Empty: they ask
# for approval as before. Dry-run needs neither: its funding source is fake.
PAYPAL_DEMO_VAULT_ID=

# --- Human alerts (see docs/ZAPIER.md)
# Webhooks by Zapier "Catch Hook" URL. Must be https (http only for localhost).
# Empty means no alerts. Check it with: python -m trustee.alerts --test
# TRUSTEE_ALERT_WEBHOOK_URL=
# Optional. Signs each body: X-Trustee-Signature: sha256=<HMAC-SHA256 hex>.
# TRUSTEE_ALERT_WEBHOOK_SECRET=
# Optional comma list: dispute,operator_resolved,paypal_alert,signature_rejected,mandate_recheck,approval_expired,paypal_call_failed
# TRUSTEE_ALERT_KINDS=
# 1 also alerts on arena demo runs (use for the video). Default 0.
# TRUSTEE_ALERT_ARENA=0
