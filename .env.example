# PayPal sandbox (Developer Dashboard → sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) | live
PAYPAL_ENV=sandbox

# OpenAI-compatible LLM (NIM, OpenAI, Ollama, ...)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TEMPERATURE=0.1

# Webhook public URL (Render/ngrok)
WEBHOOK_URL=
